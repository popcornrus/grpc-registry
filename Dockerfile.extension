# Build stage
FROM golang:1.21-alpine AS builder

# Install essential build tools
RUN apk add --no-cache git

# Set the working directory
WORKDIR /app

# Copy go.mod and go.sum first to leverage Docker caching
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the source code
COPY . .

# Build the extension server
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o /app/extension-server ./examples/extension/main.go

# Build the registration client
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o /app/registration-client ./examples/client/main.go

# Final stage
FROM alpine:3.18

# Install certificates for TLS support
RUN apk --no-cache add ca-certificates

# Set the working directory
WORKDIR /app

# Copy the binaries from the builder stage
COPY --from=builder /app/extension-server .
COPY --from=builder /app/registration-client .

# Copy startup script
COPY docker-scripts/start-extension.sh /app/start.sh
RUN chmod +x /app/start.sh

# Create a data directory
RUN mkdir -p /app/data

# Expose the gRPC port
EXPOSE 53000

# Run the startup script
ENTRYPOINT ["/app/start.sh"]
